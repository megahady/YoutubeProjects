     <item>
      <widget class="QPushButton" name="btn_Open">
       <property name="styleSheet">
        <string notr="true">QPushButton {
    color: #ffffff;
    font-family: Eina01, sans-serif;
    font-size: 16px;
    font-weight: 800;
    min-width: 100px;
    max-width: 100px;
    min-height: 34px;
    max-height: 34px;
    padding: 0;  /* Remove extra padding for fixed size */
    border: none;
    border-radius: 40px; /* half of 80px from original */
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #ff7426, stop:1 #f93a13);
}

QPushButton:hover:!disabled {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgb(255,116,38), stop:1 rgb(249,58,19));
}

QPushButton:pressed:!disabled {
    color: #cccccc;
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 rgba(0,0,0,0.2), stop:1 rgba(0,0,0,0.2)), 
                qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #ff7426, stop:1 #f93a13);
}

QPushButton:disabled {
    opacity: 0.24;
    background: #888888;
    color: #ccc;
}
</string>
       </property>
       <property name="text">
        <string>Open</string>
       </property>
      </widget>
     </item>
